{
    "name": "bancobarcelos.pds.api",
    "version": "1.0.0",
    "description": "This API is a fundamental part of a banking system that allows developers to integrate banking functionalities into their own applications. With this API, users can perform a variety of banking operations, such as creating accounts, making transfers, checking balances and much more. ",
    "main": "app.ts",
    "scripts": {
        "test": "jest --config=jest.config.ts --detectOpenHandles",
        "start": "nodemon --watch src/**/*.ts --exec node_modules/.bin/ts-node src/app.ts",
        "build": "tsc",
        "generate-models": "dotenv sequelize-auto -o './src/models' -d $DB_NAME -h $DB_HOST -u $DB_USER -x $DB_PASSWORD -e postgres --schema $SCHEMA_NAME --lang ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BancoBarcelos/bancobarcelos_api.git"
    },
    "author": "PDS",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/BancoBarcelos/bancobarcelos_api/issues"
    },
    "homepage": "https://github.com/BancoBarcelos/bancobarcelos_api#readme",
    "dependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.25",
        "@types/uuid": "^9.0.8",
        "bcrypt": "^5.1.1",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "date-fns": "^3.6.0",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "fastest-validator": "^1.18.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^3.0.3",
        "path": "^0.12.7",
        "pg": "^8.11.5",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.3",
        "ts-node": "^10.9.2",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "@types/faker": "^6.6.9",
        "@types/jest": "^29.5.12",
        "@types/node-cron": "^3.0.11",
        "@types/supertest": "^6.0.2",
        "faker": "^5.5.3",
        "jest": "^29.7.0",
        "nodemon": "^3.1.0",
        "sequelize-auto": "^0.8.8",
        "supertest": "^6.3.4",
        "ts-jest": "^29.1.2",
        "typescript": "^5.4.2"
    }
}
